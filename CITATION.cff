    given-names: Adrian
license: MIT
repository-code: "https://github.com/aschreyer/usr"
url: "https://pypi.org/project/rd-usr/"
keywords:
  - cheminformatics
  - molecular shape
  - rdkit
  - ultrafast shape recognition
  - virtual screening
preferred-citation:
